#!/usr/bin/env bash
# desc: AI helper — ai <task> · ai chat · ai web <question> · ai explain (Claude, Gemini, OpenAI-compatible)
#   ai <text>            → AI writes a command, then Run / Edit / Copy / Cancel
#   ai chat              → conversation with memory (/new /about /web /copy /exit)
#   ai web <question>    → searches the web, answers with sources (Claude or Gemini)
#   ai explain           → explains an error: paste it, give it as text, or pipe:  cmd &| ai explain
#   arda ask setup       → pick a provider, paste its key, test it (keys are kept per provider)
#   arda ask status      → which AI is active · arda ask test → raw answer (debugging)
set -euo pipefail
source "${ARDAOS_LIB:-/usr/lib/ardaos}/lib.sh"
# shellcheck source=../ai.sh
source "$ARDAOS_LIB/ai.sh"

# --- setup / status ------------------------------------------------------------------
setup() {
  ai_load
  if has gum; then
    gum style --border rounded --padding "1 3" --margin "1 0" --border-foreground "$ARDAOS_ACCENT" \
      "$(gum style --bold "🤖  AI setup")" "" \
      "Pick a provider, paste its key, done." \
      "$(gum style --faint "Keys stay on this device ($AI_CONF, only you can read it).")"
  else ui_title "AI setup"; fi
  local labels=() p id="" key model pick
  for p in "${PROVIDERS[@]}"; do labels+=("$(cut -d'|' -f2 <<< "$p")"); done
  pick=$(ui_choose "step 1/3 · which AI?" "${labels[@]}") || exit 0
  for p in "${PROVIDERS[@]}"; do [[ $(cut -d'|' -f2 <<< "$p") == "$pick" ]] && id=${p%%|*}; done
  [[ -n $id ]] || exit 0

  case $id in
    anthropic) ui_info "key: console.anthropic.com → API keys (starts with sk-ant-)" ;;
    gemini)    ui_info "key: aistudio.google.com → Get API key (your Radar/Lifelog project works)" ;;
    openai)    conf_set URL_openai "$(input "https://api.groq.com/openai/v1" "$(var URL openai)" "" "step 1/3 · base URL" "🌐 ")" ;;
  esac

  key=$(var KEY "$id")
  if [[ -n $key ]] && ui_confirm "Keep the saved $pick key (…${key: -4})?"; then :
  else key=$(input "paste it here (hidden)" "" secret "step 2/3 · your $pick API key" "🔑 "); fi
  [[ -n $key ]] || { ui_fail "no key, nothing changed"; exit 1; }
  model=$(input "$(field "$id" 3)" "$(var MODEL "$id")" "" "step 3/3 · model (Enter = default)" "🧠 ")
  [[ -n $model ]] || model=$(field "$id" 3)
  [[ -n $model ]] || { ui_fail "this provider needs a model name"; exit 1; }

  conf_set "KEY_$id" "$key"; conf_set "MODEL_$id" "$model"
  local out
  out=$(spin "testing $pick" ai_send "$id" 'Reply with only this JSON: {"command":"","explain":"hi"}' "$(one_msg test)" json)
  if ! jq -e . >/dev/null 2>&1 <<< "$(strip_fences <<< "$out")"; then
    ui_fail "the test didn't work. Here's what came back:"
    printf '\n\e[2m%s\e[0m\n\n' "${out:-(nothing — check your internet)}"
    if ui_confirm "Use $pick anyway?"; then conf_set AI_PROVIDER "$id"; ui_warn "active, but answers may fail"
    else ui_info "nothing activated — run '$ARDAOS_CMD ask setup' again"; fi
    exit 1
  fi
  conf_set AI_PROVIDER "$id"
  ui_ok "$pick answers! Active now · $model"
  ui_info "try: ai find files bigger than 100MB · ai chat · ai web … · ai explain"
}

status() {
  ai_load
  ui_title "AI"
  local p id mark key
  for p in "${PROVIDERS[@]}"; do
    id=${p%%|*}; mark="  "; key=$(var KEY "$id")
    [[ $id == "${AI_PROVIDER:-}" ]] && mark="▸ "
    printf '  %s\e[1m%-10s\e[0m %-24s %s\n' "$mark" "$(short_label "$id")" \
      "$(var MODEL "$id")" "$([[ -n $key ]] && echo "key …${key: -4}" || echo "no key")"
  done
  echo; ui_info "switch: $ARDAOS_CMD ask setup"
}

# --- ai <task>: one command ----------------------------------------------------------------
command_system() {
  cat <<EOF
You are the command helper inside $(where_am_i). The user's shell is fish, but your command will be run with bash.
Current directory: $PWD
Reply with ONLY a JSON object, no code fences: {"command": "...", "explain": "..."}
- "command": one bash command line that does what the user asks. Prefer safe, read-only commands.
  Use "" if the user asked a question that is not a command request.
- "explain": one short sentence explaining it (or the answer, if command is "").
EOF
}

ask() {
  require_ai
  local q="$*" raw cmd explain
  [[ -n $q ]] || q=$(input "what do you want to do?")
  [[ -n $q ]] || exit 0
  raw=$(spin "thinking ($(short_label "$AI_PROVIDER"))" ai_send "$AI_PROVIDER" "$(command_system)" "$(one_msg "$q")" json)
  raw=$(strip_fences <<< "$raw")
  if ! cmd=$(jq -er '.command' <<< "$raw" 2>/dev/null); then
    echo; echo "$raw"; exit 0                                  # error or plain text → just show it
  fi
  explain=$(jq -r '.explain // ""' <<< "$raw")
  echo
  [[ -n $explain ]] && ui_info "$explain"
  [[ -n $cmd ]] && offer_run "$cmd"
  return 0
}

# --- ai web: search + sources -------------------------------------------------------------
web() {
  require_ai
  local q="$*" ans src
  [[ -n $q ]] || q=$(input "what should I look up?" "" "" "🌐 ai web")
  [[ -n $q ]] || exit 0
  src=$(mktemp); export AI_SOURCES=$src
  ans=$(spin "searching the web ($(short_label "$AI_PROVIDER"))" ai_send "$AI_PROVIDER" \
    "You are a research assistant in a terminal. Search the web, then answer in the user's language.
Start with the direct answer, then short details. Markdown, under 200 words unless asked. Today is $(date +%F)." \
    "$(one_msg "$q")" web)
  if [[ $ans == error:* ]]; then ui_fail "${ans#error: }"; rm -f "$src"; exit 1; fi
  echo; render_md "$ans"
  print_sources "$src"; rm -f "$src"
}

# --- ai explain: errors ------------------------------------------------------------------
explain() {
  require_ai
  local text="" raw md cmd
  if [[ ! -t 0 ]]; then                                  # piped:  npm run build &| ai explain
    text=$(cat)
    if : 2>/dev/null </dev/tty; then exec </dev/tty; fi    # give the keyboard back for Run/Copy
  elif (($#)); then text="$*"
  else
    ui_info "paste the error, then press Enter and Ctrl+D (phone: CTRL, then d)"
    text=$(cat)
  fi
  [[ -n ${text//[[:space:]]/} ]] || { ui_warn "nothing to explain"; exit 0; }
  text=$(tail -c 12000 <<< "$text")                       # long logs: the end has the error
  raw=$(spin "reading the error" ai_send "$AI_PROVIDER" "You explain terminal errors on $(where_am_i).
The user gives you an error message or command output. Reply with ONLY a JSON object, no code fences:
{\"explain\": \"...\", \"command\": \"...\"}
- \"explain\": markdown in the user's language, at most ~120 words, three bold parts: **What happened**, **Why**, **Fix**.
- \"command\": one bash command that fixes it, or \"\" when the fix is not a single command." "$(one_msg "$text")" json)
  if [[ $raw == error:* ]]; then ui_fail "${raw#error: }"; exit 1; fi
  raw=$(strip_fences <<< "$raw")
  if ! md=$(jq -er '.explain' <<< "$raw" 2>/dev/null); then echo; render_md "$raw"; exit 0; fi
  cmd=$(jq -r '.command // ""' <<< "$raw")
  echo; render_md "$md"
  [[ -n $cmd ]] && offer_run "$cmd"
  return 0
}

# --- ai chat: conversation with memory ---------------------------------------------------
chat_system() {
  local about
  about=$(sed '/<!--/,/-->/d' "$AI_CHAT_DIR/about.md" 2>/dev/null | sed '/^[[:space:]]*$/d')
  cat <<EOF
You are the AI inside ArdaOS, the user's personal terminal-first OS, running on $(where_am_i).
Talk like a helpful friend: short, plain and direct, in the user's language.
Use markdown; put commands in \`\`\`bash blocks (the user runs them). Today is $(date '+%A %F %H:%M').
${about:+What the user wrote about themselves:
$about}
EOF
}

chat_input() {
  if has gum; then
    gum input --placeholder "message… (/help)" --char-limit 0 --width 0 --prompt "❯ " \
      --prompt.foreground "$ARDAOS_ACCENT" --cursor.foreground "$ARDAOS_ACCENT"
  else local v; read -erp "❯ " v || return 1; printf '%s' "$v"; fi
}

chat() {
  require_ai
  local cur="$AI_CHAT_DIR/current.json" about="$AI_CHAT_DIR/about.md" rgb
  mkdir -p "$AI_CHAT_DIR/history"
  [[ -s $cur ]] && jq -e 'type=="array"' "$cur" >/dev/null 2>&1 || echo '[]' > "$cur"
  [[ -f $about ]] || cat > "$about" <<'EOF'
# About me
<!-- Write anything the AI should know: your name, job, what you're learning,
     how you like answers. It is sent with every chat message.
     Edit it any time with /about inside ai chat. Lines inside these marks are ignored. -->
EOF
  rgb=$(accent_rgb)
  local title; title="💬 ai chat · $(short_label "$AI_PROVIDER") · $(var MODEL "$AI_PROVIDER")"
  if has gum; then gum style --border rounded --padding "0 2" --margin "1 0" --border-foreground "$ARDAOS_ACCENT" \
                     "$(gum style --bold "$title")" "$(gum style --faint "/new · /about · /web <q> · /copy · /exit")"
  else ui_title "$title"; fi
  local n; n=$(jq length "$cur")
  ((n)) && ui_info "continuing ($((n / 2)) messages) · /new starts fresh"

  local q mode msgs ans src
  while true; do
    q=$(chat_input) || break                               # Esc / Ctrl+C
    q=$(sed 's/^[[:space:]]*//;s/[[:space:]]*$//' <<< "$q")
    [[ -n $q ]] || continue
    mode=text
    case $q in
      /exit|/quit|/q) break ;;
      /help) ui_info "/new fresh chat · /about what the AI knows about you · /web <q> search · /copy last answer · /exit"; continue ;;
      /new)
        if (($(jq length "$cur"))); then mv "$cur" "$AI_CHAT_DIR/history/$(date +%Y%m%d-%H%M%S).json"; fi
        echo '[]' > "$cur"; ui_ok "new chat"; continue ;;
      /about) "${EDITOR:-nvim}" "$about" </dev/tty >/dev/tty; ui_ok "saved — the AI reads it from now on"; continue ;;
      /copy) copy "$(jq -r '[.[] | select(.role=="assistant")] | last.content // ""' "$cur")"; continue ;;
      "/web "*) mode=web; q=${q#/web } ;;
      /*) ui_warn "unknown command — /help"; continue ;;
    esac
    printf '\n  \e[1;38;2;%sm❯\e[0m %s\n' "$rgb" "$q"
    msgs=$(jq --arg q "$q" '. + [{role:"user", content:$q}] | .[-21:]' "$cur")   # odd → starts with the user
    src=$(mktemp); export AI_SOURCES=$src
    ans=$(spin "thinking" ai_send "$AI_PROVIDER" "$(chat_system)" "$msgs" "$mode")
    if [[ $ans == error:* ]]; then ui_fail "${ans#error: }"; rm -f "$src"; continue; fi
    echo; render_md "$ans"; print_sources "$src"; rm -f "$src"; echo
    jq --arg q "$q" --arg a "$ans" '. + [{role:"user", content:$q}, {role:"assistant", content:$a}]' \
      "$cur" > "$cur.tmp" && mv "$cur.tmp" "$cur"
  done
  echo; ui_info "saved — ai chat picks up where you left off"
}

case "${1:-}" in
  setup)   setup ;;
  status)  status ;;
  test)    require_ai; ai_send "$AI_PROVIDER" 'Reply with only this JSON: {"command":"","explain":"hi"}' "$(one_msg test)" json ;;
  chat)    chat ;;
  web)     shift; web "$@" ;;
  explain) shift; explain "$@" ;;
  *)       ask "$@" ;;
esac
