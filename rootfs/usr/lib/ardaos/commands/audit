#!/usr/bin/env bash
# desc: safe security checkup for ONE device you own (arda audit 192.168.1.64)
#   Read-only: it looks, it never logs in, changes or breaks anything.
#   Only run it against a device you own or are authorized to test.
set -euo pipefail
source "${ARDAOS_LIB:-/usr/lib/ardaos}/lib.sh"

ip="${1:-}"
[[ $ip == -h || $ip == --help ]] && { sed -n '2,4s/^# *//p' "$0"; exit 0; }
[[ -n $ip ]] || { ui_fail "which device? e.g. $ARDAOS_CMD audit 192.168.1.64"; exit 1; }
[[ $ip =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || { ui_fail "give one IP address, not a range"; exit 1; }
has nmap || { ui_fail "nmap is missing — $ARDAOS_CMD pack install network"; exit 1; }

ui_title "🔍 security checkup · $ip"
ui_info "read-only — nothing is changed or logged into"

notes=()   # findings worth acting on

# --- 1. which doors are open ---------------------------------------------------
scan=$(ui_spin_out "scanning ports" nmap -sT -T4 -n --open -p- --max-retries 1 "$ip" 2>/dev/null || true)
mapfile -t open < <(sed -n 's/^\([0-9]*\)\/tcp *open *\(.*\)/\1 \2/p' <<< "$scan")
if ((${#open[@]} == 0)); then
  ui_warn "no open TCP ports found (device off, firewalled, or wrong IP)"
  exit 0
fi
printf '\n  \e[1mopen ports\e[0m\n'
for o in "${open[@]}"; do printf '  %-7s %s\n' "${o%% *}" "${o#* }"; done
ports=" ${scan//$'\n'/ } "

# a few services that are risky to expose to the whole network
grep -q '^23/tcp' <<< "$scan"   && notes+=("Telnet (23) is open — unencrypted, anyone on the network can read the login. Turn it off, use SSH.")
grep -q '^21/tcp' <<< "$scan"   && notes+=("FTP (21) is open — sends passwords in clear text. Prefer SFTP/SCP.")
grep -q '^2323/tcp' <<< "$scan" && notes+=("Port 2323 is open — often a backdoor Telnet on IoT gear. Investigate.")

# --- 2. is a camera stream open to anyone? ------------------------------------
if [[ $ports == *" 554/tcp"* ]] && has ffprobe; then
  if ui_spin_out "checking RTSP (554)" ffprobe -rtsp_transport tcp -timeout 3000000 \
       -i "rtsp://$ip:554/" >/dev/null 2>&1; then
    notes+=("RTSP stream on 554 played with NO password — anyone on the network can watch it. Turn on RTSP authentication.")
    ui_warn "RTSP stream is open without a password"
  else
    ui_ok "RTSP needs a login (good)"
  fi
fi

# --- 3. HTTPS certificate & cipher strength -----------------------------------
for p in 443 8443; do
  [[ $ports == *" $p/tcp"* ]] || continue
  tls=$(ui_spin_out "checking TLS on $p" nmap -sT -n --script ssl-enum-ciphers -p "$p" "$ip" 2>/dev/null || true)
  grep -q 'least strength: [CF]' <<< "$tls" && notes+=("TLS on $p offers weak ciphers — update the firmware or disable old SSL/TLS.")
  grep -qi 'SSLv3\|TLSv1.0\|TLSv1.1' <<< "$tls" && notes+=("Port $p still allows old SSL/TLS (v1.0/1.1) — disable them.")
  grep -qi 'expired\|self-signed' <<< "$tls" && ui_info "port $p: certificate is self-signed or expired (common on local cameras)"
done

# --- 4. a plain-HTTP admin panel ----------------------------------------------
if [[ $ports == *" 80/tcp"* ]]; then
  server=$(curl -m 4 -s -I "http://$ip/" 2>/dev/null | tr -d '\r' | sed -n 's/^[Ss]erver: *//p' | head -1 || true)
  [[ -n $server ]] && ui_info "web server: $server"
  notes+=("The admin page is on plain HTTP (80) — your password crosses the network unencrypted. Use HTTPS if the device supports it.")
fi

# --- 5. the reminder that actually matters ------------------------------------
notes+=("Default passwords: make sure this device is NOT still on admin/admin, admin/12345 or a blank password — that is how most cameras get taken over. Set a long unique one.")

# --- report -------------------------------------------------------------------
echo
if ((${#notes[@]})); then
  printf '  \e[1;33mthings to check (%s)\e[0m\n' "${#notes[@]}"
  for n in "${notes[@]}"; do printf '  \e[33m•\e[0m %s\n' "$n"; done
fi
echo
ui_info "this is a checklist, not a verdict — a device you own is yours to harden"
