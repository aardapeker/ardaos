#!/usr/bin/env bash
# desc: find IP cameras & NVRs on a network (needs the 'network' pack: arda pack install network)
#   arda cams                 → scan your current /24
#   arda cams 192.168.1.0/24  → scan a specific range
# Only scan networks you own or are authorized to test.
set -uo pipefail
source "${ARDAOS_LIB:-/usr/lib/ardaos}/lib.sh"

has nmap || { ui_fail "needs nmap — run: $ARDAOS_CMD pack install network"; exit 1; }

# work out the range: argument, or this device's own /24
range="${1:-}"
if [[ -z $range ]]; then
  ip=$(ip -4 route get 1.1.1.1 2>/dev/null | grep -oE 'src [0-9.]+' | awk '{print $2}')
  [[ -z $ip ]] && ip=$(ip -4 addr 2>/dev/null | grep -oE 'inet [0-9.]+' | grep -v 127.0.0 | head -1 | awk '{print $2}')
  [[ -n $ip ]] || { ui_fail "couldn't detect your network — pass one: $ARDAOS_CMD cams 192.168.1.0/24"; exit 1; }
  range="${ip%.*}.0/24"
fi

ui_title "scanning $range for cameras"
ui_warn "only scan networks you own or are allowed to test"
echo

# camera-ish ports: 554 RTSP, 80/443 web, 8000 Hikvision, 37777 Dahua, 2020 ONVIF
scan=$(mktemp)
# -sT works without root (phone-friendly); -Pn: don't skip hosts that ignore ping
if ! ui_spin "nmap (this can take a minute)" nmap -sT -Pn --open \
     -p 80,443,554,8000,8080,37777,2020 "$range" -oG "$scan" >/dev/null 2>&1; then
  ui_fail "scan failed"; rm -f "$scan"; exit 1
fi

brand() {  # guess the brand from which ports are open
  case " $1 " in
    *" 8000 "*) echo "Hikvision" ;;
    *" 37777 "*) echo "Dahua" ;;
    *" 554 "*) echo "camera/NVR" ;;
    *) echo "device" ;;
  esac
}
label() { case $1 in 554) echo RTSP;; 80|8080) echo web;; 443) echo https;; 2020) echo ONVIF;; *) echo "$1";; esac; }

printf '  \e[1m%-16s %-12s %s\e[0m\n' "IP" "likely" "open ports"
found=0
while read -r _ ip ports; do
  [[ $ip == Host:* ]] && continue   # skip malformed
  open=$(grep -oE '[0-9]+/open' <<< "$ports" | cut -d/ -f1 | tr '\n' ' ')
  [[ -z $open ]] && continue
  names=$(for p in $open; do label "$p"; done | tr '\n' ' ')
  printf '  \e[38;2;122;162;247m%-16s\e[0m %-12s %s\n' "$ip" "$(brand "$open")" "$names"
  ((found++))
done < <(grep '/open' "$scan" | sed -E 's/Host: ([0-9.]+).*Ports: (.*)Ignored.*/X \1 \2/; t; s/Host: ([0-9.]+).*Ports: (.*)/X \1 \2/')
rm -f "$scan"

echo
if ((found)); then
  ui_ok "$found device(s) with camera-like ports"
  ui_info "watch a stream:  mpv rtsp://user:pass@IP:554/  ·  inspect it:  ffprobe rtsp://..."
else
  ui_warn "nothing found — try a different range: $ARDAOS_CMD cams 192.168.0.0/24"
fi
