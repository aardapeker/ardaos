#!/usr/bin/env bash
# desc: check that everything works
set -uo pipefail
source "${ARDAOS_LIB:-/usr/lib/ardaos}/lib.sh"

fails=0
check() {  # check "label" command...
  if "${@:2}" >/dev/null 2>&1; then ui_ok "$1"; else ui_fail "$1"; ((fails++)); fi
}

ui_title "${DISTRO_NAME:-ArdaOS} doctor"

echo "  tools"
tools="fish starship eza bat zoxide fd rg fzf yazi lazygit nvim gum fastfetch zellij"
if is_termux; then tools="$tools htop"
else tools="sway kitty btop atuin $tools spotify_player firefox code podman node java"; fi
for c in $tools; do
  check "$c" has "$c"
done

echo; echo "  fonts"
for f in "${ARDAOS_FONTS[@]}"; do
  IFS='|' read -r name dir family <<< "$f"
  if is_termux; then check "$name" test -d "$ARDAOS_FONT_DIR/$dir"
  else check "$name" sh -c "fc-list : family | grep -qiF '$family'"; fi
done

if is_termux; then
  check "theme ($(state_get THEME))" test -f "$HOME/.termux/colors.properties"
  check "font file" test -f "$HOME/.termux/font.ttf"
  echo; ((fails == 0)) && ui_ok "all good, dude 😎" || ui_warn "$fails problem(s). Re-run termux-install.sh"
  exit $((fails > 0))
fi

echo; echo "  system"
check "network"  sh -c "nmcli -t -f STATE general | grep -q '^connected'"
check "internet" getent hosts github.com
check "audio"    wpctl status
check "podman"   podman info
check "theme ($(state_get THEME))" test -f "$HOME/.config/kitty/theme.conf"
check "3D acceleration" sh -c 'ls /dev/dri/renderD*'
has systemd-detect-virt && ui_info "running on: $(systemd-detect-virt 2>/dev/null || echo 'real hardware')"

echo
if ((fails == 0)); then ui_ok "all good, dude 😎"
else ui_warn "$fails problem(s). No 3D? Turn on 3D acceleration in Boxes."; fi
exit $((fails > 0))
