#!/usr/bin/env bash
# desc: switch the terminal font
#   arda font | arda font apply "Maple Mono" | arda font current
set -euo pipefail
source "${ARDAOS_LIB:-/usr/lib/ardaos}/lib.sh"

FONTS=("JetBrains Mono" "Maple Mono" "Iosevka")
CFG="${XDG_CONFIG_HOME:-$HOME/.config}"

apply() {
  local font=$1
  if has fc-list && ! fc-list : family | grep -qiF "$font"; then
    ui_warn "'$font' isn't installed — try: $ARDAOS_CMD doctor"
  fi
  mkdir -p "$CFG/kitty" "$CFG/foot"
  printf '# generated by %s font\nfont_family %s\n' "$ARDAOS_CMD" "$font" > "$CFG/kitty/font.conf"
  printf '# generated by %s font\n[main]\nfont=%s:size=12\n' "$ARDAOS_CMD" "$font" > "$CFG/foot/font.ini"
  state_set FONT "$font"
  pkill -USR1 -x kitty 2>/dev/null || true
  ui_ok "font → $font"
}

case "${1:-menu}" in
  current) state_get FONT ;;
  list)    printf '%s\n' "${FONTS[@]}" ;;
  apply)   apply "${2:?usage: $ARDAOS_CMD font apply <name>}" ;;
  menu)    pick=$(ui_choose "pick a font" "${FONTS[@]}") && [[ -n $pick ]] && apply "$pick" ;;
  *)       ui_fail "usage: $ARDAOS_CMD font [list|current|apply <name>]"; exit 1 ;;
esac
