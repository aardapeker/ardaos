#!/usr/bin/env bash
# desc: switch the terminal font
#   arda font | arda font apply "Maple Mono" | arda font current
set -euo pipefail
source "${ARDAOS_LIB:-/usr/lib/ardaos}/lib.sh"

CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
names=(); for f in "${ARDAOS_FONTS[@]}"; do names+=("${f%%|*}"); done

apply_termux() {  # Termux uses exactly one file: ~/.termux/font.ttf
  local dir="$ARDAOS_FONT_DIR/$FONT_DIRNAME" file
  file=$(find "$dir" -iname '*NerdFontMono-Regular.ttf' 2>/dev/null | head -1)
  [[ -n $file ]] || file=$(find "$dir" -iname '*-Regular.ttf' 2>/dev/null | head -1)
  [[ -n $file ]] || { ui_fail "'$1' isn't installed — re-run termux-install.sh"; exit 1; }
  mkdir -p "$HOME/.termux"
  cp "$file" "$HOME/.termux/font.ttf"
  termux-reload-settings 2>/dev/null || true
}

apply_desktop() {
  if has fc-list && ! fc-list : family | grep -qiF "$FONT_FAMILY"; then
    ui_warn "'$1' isn't installed — try: $ARDAOS_CMD doctor"
  fi
  mkdir -p "$CFG/kitty" "$CFG/foot"
  printf '# generated by %s font\nfont_family %s\n' "$ARDAOS_CMD" "$FONT_FAMILY" > "$CFG/kitty/font.conf"
  printf '# generated by %s font\n[main]\nfont=%s:size=12\n' "$ARDAOS_CMD" "$FONT_FAMILY" > "$CFG/foot/font.ini"
  pkill -USR1 -x kitty 2>/dev/null || true
}

apply() {
  font_lookup "$1" || { ui_fail "unknown font '$1' — try: $ARDAOS_CMD font list"; exit 1; }
  if is_termux; then apply_termux "$1"; else apply_desktop "$1"; fi
  state_set FONT "$1"
  ui_ok "font → $1"
}

case "${1:-menu}" in
  current) state_get FONT ;;
  list)    printf '%s\n' "${names[@]}" ;;
  apply)   apply "${2:?usage: $ARDAOS_CMD font apply <name>}" ;;
  menu)    pick=$(ui_choose "pick a font" "${names[@]}") && [[ -n $pick ]] && apply "$pick" ;;
  *)       ui_fail "usage: $ARDAOS_CMD font [list|current|apply <name>]"; exit 1 ;;
esac
