#!/usr/bin/env bash
# desc: launch an app (menu, or: arda go web)
set -euo pipefail
source "${ARDAOS_LIB:-/usr/lib/ardaos}/lib.sh"

APPS="$ARDAOS_SHARE/apps.list"   # key|Label|command|gui or tui

# only apps that exist here (and no GUI apps without a graphical session)
available() {
  local key label cmd kind
  while IFS='|' read -r key label cmd kind; do
    has "${cmd%% *}" || continue
    [[ $kind == gui && -z ${WAYLAND_DISPLAY:-} ]] && continue
    echo "$key|$label|$cmd|$kind"
  done < "$APPS"
}

launch() {
  local cmd=$1 kind=$2
  if ! in_sway; then exec $cmd; fi                       # Termux / plain console: run here
  [[ $kind == tui ]] && cmd="kitty --class ardaos-app -e $cmd"
  swaymsg exec "$cmd" >/dev/null
}

apps=$(available)
if [[ -n ${1:-} ]]; then                       # arda go web
  line=$(grep "^$1|" <<< "$apps") || { ui_fail "no app '$1' here"; exit 1; }
else                                           # menu
  label=$(cut -d'|' -f2 <<< "$apps" | fzf --prompt "go ❯ " --height 100% --no-info) || exit 0
  line=$(grep -F "|$label|" <<< "$apps")
fi

IFS='|' read -r _ _ cmd kind <<< "$line"
launch "$cmd" "$kind"
