#!/usr/bin/env bash
# desc: launch an app (menu, or: arda go web)
set -euo pipefail
source "${ARDAOS_LIB:-/usr/lib/ardaos}/lib.sh"

APPS="$ARDAOS_SHARE/apps.list"   # key|Label|command|gui or tui

launch() {
  local cmd=$1 kind=$2
  [[ $kind == tui ]] && cmd="kitty --class ardaos-app -e $cmd"
  if in_sway; then swaymsg exec "$cmd" >/dev/null
  else setsid -f sh -c "$cmd" >/dev/null 2>&1; fi
}

if [[ -n ${1:-} ]]; then                       # arda go web
  line=$(grep "^$1|" "$APPS") || { ui_fail "no app '$1'"; exit 1; }
else                                           # menu
  label=$(cut -d'|' -f2 "$APPS" | fzf --prompt "go ❯ " --height 100% --no-info) || exit 0
  line=$(grep -F "|$label|" "$APPS")
fi

IFS='|' read -r _ _ cmd kind <<< "$line"
launch "$cmd" "$kind"
