#!/usr/bin/env bash
# desc: extra tool packs (arda pack list · show hacker · install hacker · install all)
set -euo pipefail
source "${ARDAOS_LIB:-/usr/lib/ardaos}/lib.sh"

PACKS="$ARDAOS_SHARE/packs"
pack_file() { local f="$PACKS/$1.pack"; [[ -f $f ]] || { ui_fail "no pack '$1' — try: $ARDAOS_CMD pack list"; exit 1; }; echo "$f"; }
trim() { local s=$1; s=${s#"${s%%[![:space:]]*}"}; printf '%s' "${s%"${s##*[![:space:]]}"}"; }

rows() {  # rows <pack> → "package|what" for THIS machine (Termux or Fedora)
  local t f what
  while IFS='|' read -r t f what; do
    t=$(trim "$t"); [[ -z $t || $t == \#* ]] && continue
    f=$(trim "$f"); what=$(trim "$what")
    if is_termux; then echo "$t|$what"; else echo "$f|$what"; fi
  done < "$(pack_file "$1")"
}

case "${1:-list}" in
  list)
    ui_title "packs"
    for f in "$PACKS"/*.pack; do
      printf '  \e[1m%-8s\e[0m %s\n' "$(basename "$f" .pack)" "$(sed -n 's/^# desc: //p' "$f")"
    done ;;
  show)
    p=${2:?usage: $ARDAOS_CMD pack show <pack>}
    ui_title "$p pack"
    sed -n 's/^# desc: /  /p' "$(pack_file "$p")"; echo
    while IFS='|' read -r pkg what; do
      [[ $pkg == gh:* ]] && pkg=$(cut -d@ -f3 <<< "$pkg")   # show just the binary name
      [[ $pkg == - ]] && printf '  \e[2m%-22s %s\e[0m\n' "(n/a here)" "$what" || printf '  \e[1m%-22s\e[0m %s\n' "${pkg#npm:}" "$what"
    done < <(rows "$p") ;;
  install)
    [[ -n ${2:-} ]] || { ui_fail "usage: $ARDAOS_CMD pack install <pack>… | all"; exit 1; }
    if [[ $2 == all ]]; then mapfile -t names < <(for f in "$PACKS"/*.pack; do basename "$f" .pack; done)
    else names=("${@:2}"); fi
    if ((${#names[@]} > 1)); then                    # several packs → one after another
      is_termux || sudo -v
      for n in "${names[@]}"; do "$0" install "$n" || ui_warn "$n pack had problems"; done
      ui_ok "done: ${names[*]}"; exit 0
    fi
    p=${names[0]}; [[ -f $PACKS/$p.pack ]] || { ui_fail "no pack '$p' — try: $ARDAOS_CMD pack list"; exit 1; }
    ui_title "installing the $p pack"
    is_termux || sudo -v
    sudo_=(); is_termux || sudo_=(sudo)
    bin_dir=/usr/local/bin; is_termux && bin_dir="$PREFIX/bin"
    while IFS='|' read -r pkg _; do
      [[ $pkg == - ]] && continue
      name=${pkg#npm:}
      if [[ $pkg == gh:* ]]; then                    # gh:owner/repo@regex@binary → GitHub release
        IFS='@' read -r repo regex name <<< "${pkg#gh:}"
        list=$(mktemp); printf 'bin | %s | %s | %s\n' "$repo" "$regex" "$name" > "$list"; chmod 644 "$list"
        cmd=("${sudo_[@]}" env ARDAOS_BIN_DIR="$bin_dir" "$ARDAOS_LIB/tools.sh" "$list")
      elif [[ $pkg == npm:* ]]; then cmd=("${sudo_[@]}" npm install -g "$name")
      elif is_termux; then cmd=(pkg install -y "$pkg")
      else cmd=(sudo dnf install -y "$pkg"); fi
      if ui_spin "$name" "${cmd[@]}"; then ui_ok "$name"; else ui_warn "$name not available, skipped"; fi
    done < <(rows "$p")
    ui_info "see what you got: $ARDAOS_CMD pack show $p" ;;
  *) ui_fail "usage: $ARDAOS_CMD pack [list|show <pack>|install <pack>…|install all]"; exit 1 ;;
esac
