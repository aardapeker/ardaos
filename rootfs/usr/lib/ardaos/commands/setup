#!/usr/bin/env bash
# desc: setup wizard — theme, font, tool packs, AI, phone/laptop extras (runs once on first start)
#   arda setup              → run the wizard (any time)
#   arda setup --first-run  → only if it never ran (used by the home screen)
set -euo pipefail
source "${ARDAOS_LIB:-/usr/lib/ardaos}/lib.sh"

if [[ ${1:-} == --first-run ]]; then
  [[ -n $(state_get SETUP) ]] && exit 0
  [[ -t 0 && -t 1 ]] || exit 0                      # only in a real terminal
fi

# never auto-start twice: a wizard left with Ctrl+C counts as "skipped"
# shellcheck disable=SC2034  # read by the EXIT trap
finished=0
trap '((finished)) || state_set SETUP skipped' EXIT

CMDS="$ARDAOS_LIB/commands"
done_list=()
step=0 total=6

header() {  # header "title" "one line of explanation"
  ((++step))
  echo
  if has gum; then
    gum style --foreground "$ARDAOS_ACCENT" --bold "step $step/$total · $1"
    gum style --faint "$2"
  else
    printf '\e[1mstep %s/%s · %s\e[0m\n\e[2m%s\e[0m\n' "$step" "$total" "$1" "$2"
  fi
  echo
}

ask_yes() {  # ask_yes "question" [default yes|no]
  if has gum; then
    if [[ ${2:-yes} == yes ]]; then gum confirm "$1"; else gum confirm --default=false "$1"; fi
  else ui_confirm "$1"; fi
}

choose_many() {  # choose_many "header" option… → the chosen ones, one per line
  local h=$1; shift
  if has gum; then
    gum choose --no-limit --header "$h  (space = select, enter = done)" \
      --cursor.foreground "$ARDAOS_ACCENT" --selected.foreground "$ARDAOS_ACCENT" "$@" || true
  else
    local o; for o in "$@"; do ui_confirm "${o%% —*}?" && echo "$o"; done
  fi
}

# --- welcome ---------------------------------------------------------------------------
clear 2>/dev/null || true
if has gum; then
  gum style --border rounded --padding "1 4" --margin "1 0" --border-foreground "$ARDAOS_ACCENT" --align center \
    "$(sed 's/\$[0-9]//g' "$ARDAOS_SHARE/logo.txt")" "" \
    "$(gum style --bold "Welcome to ${DISTRO_NAME:-ArdaOS}")" \
    "$(gum style --faint "A few quick questions. Every step can be skipped and changed later.")"
else
  ui_title "Welcome to ${DISTRO_NAME:-ArdaOS}"
  ui_info "A few quick questions. Every step can be skipped and changed later."
fi
ask_yes "Start the setup?" || { ui_info "no problem — run 'arda setup' any time"; exit 0; }

# --- 1. theme ---------------------------------------------------------------------------
header "look" "Colors for the whole system. The menu recolors the screen while you scroll."
cur=$("$CMDS/theme" name 2>/dev/null || echo "Tokyo Night")
if ask_yes "Keep $cur? (No = pick another)"; then :
else "$CMDS/theme" || true; fi
newt=$("$CMDS/theme" name 2>/dev/null || true)
done_list+=("theme: ${newt:-$cur}")

# --- 2. font ----------------------------------------------------------------------------
header "font" "JetBrains Mono (clean) · Maple Mono (round, cute) · Iosevka (narrow, fits more)"
curf=$("$CMDS/font" current 2>/dev/null); curf=${curf:-JetBrains Mono}
if ask_yes "Keep $curf? (No = pick another)"; then :
else "$CMDS/font" || true; fi
newf=$("$CMDS/font" current 2>/dev/null || true)
done_list+=("font: ${newf:-$curf}")

# --- 3. tool packs ----------------------------------------------------------------------
header "tool packs" "Extra tools, installed now. Add more later with: arda pack install <name>"
opts=("everything — all packs below")
for f in "$ARDAOS_SHARE"/packs/*.pack; do
  opts+=("$(basename "$f" .pack) — $(sed -n 's/^# desc: //p' "$f")")
done
mapfile -t picked < <(choose_many "Which packs do you want?" "${opts[@]}")
if ((${#picked[@]})); then
  names=()
  for p in "${picked[@]}"; do names+=("${p%% —*}"); done
  [[ " ${names[*]} " == *" everything "* ]] && names=(all)
  is_termux || ui_info "installing needs your password once"
  "$CMDS/pack" install "${names[@]}" || ui_warn "some packs had problems — run arda install all later"
  if [[ ${names[0]} == all ]]; then done_list+=("packs: all")
  else done_list+=("packs: ${names[*]}"); fi
else
  ui_info "skipped — arda pack list shows them later"
fi

# --- 4. AI ------------------------------------------------------------------------------
header "AI" "ai <task> writes commands · ai chat talks · ai web searches · ai explain fixes errors. Needs an API key (Claude or Gemini)."
if [[ -f ${XDG_CONFIG_HOME:-$HOME/.config}/ardaos/ai.conf ]] && grep -q '^AI_PROVIDER=' "${XDG_CONFIG_HOME:-$HOME/.config}/ardaos/ai.conf"; then
  ui_ok "AI is already set up"
  ask_yes "Change it?" no && { "$CMDS/ask" setup || true; }
  done_list+=("AI: ready")
elif ask_yes "Set up the AI now?"; then
  if "$CMDS/ask" setup; then done_list+=("AI: ready"); else done_list+=("AI: not finished — arda ask setup"); fi
else
  ui_info "skipped — arda ask setup any time"
fi
if ask_yes "Tell the AI a bit about yourself? (name, job, what you're learning)" no; then
  about="${XDG_CONFIG_HOME:-$HOME/.config}/ardaos/chat/about.md"
  mkdir -p "$(dirname "$about")"
  [[ -f $about ]] || printf '# About me\n\n' > "$about"
  "${EDITOR:-nvim}" "$about"
  done_list+=("AI: knows about you")
fi

# --- 5 + 6. device-specific -------------------------------------------------------------
if is_termux; then
  header "phone files" "Lets ArdaOS see your photos and Downloads (for arda share). Android will ask once."
  if [[ -d $HOME/storage ]]; then ui_ok "already allowed"; done_list+=("phone files: allowed")
  elif ask_yes "Allow access to your phone's files?"; then
    termux-setup-storage || true
    done_list+=("phone files: asked Android")
  fi

  header "phone extras" "Two small apps from F-Droid (same place as Termux) unlock more."
  "$CMDS/buttons" >/dev/null 2>&1 || true
  cat <<'EOF'
  • Termux:API     → battery + Wi-Fi in arda status and on the home screen
                     (then give it Location permission for the Wi-Fi name)
  • Termux:Widget  → one-tap buttons on your home screen
                     (long-press home screen → Widgets → Termux:Widget)
EOF
  echo
  ask_yes "Got it?" || true
  done_list+=("home-screen buttons: ready")
else
  header "password" "The live system starts with password 'arda'. Anyone who knows that can use sudo."
  if echo "${DEFAULT_PASSWORD:-arda}" | sudo -S -k -v 2>/dev/null; then
    sudo -k
    if ask_yes "Your password is still the default. Change it now?"; then
      passwd && done_list+=("password: changed")
    else ui_warn "still the default — change it later with: passwd"; fi
  else
    ui_ok "password already changed"
  fi

  header "screen lock" "Super + L locks. It also locks after 10 minutes idle and before sleep."
  "$CMDS/lock" render >/dev/null 2>&1 || true
  ui_ok "lock screen drawn in your theme"
  done_list+=("lock screen: ready")
fi

# --- done --------------------------------------------------------------------------------
# shellcheck disable=SC2034  # read by the EXIT trap
finished=1
state_set SETUP "done"
echo
summary=$(printf '  ✓ %s\n' "${done_list[@]}")
if has gum; then
  gum style --border rounded --padding "1 3" --margin "1 0" --border-foreground "$ARDAOS_ACCENT" \
    "$(gum style --bold "All set 🐈")" "" "$summary" "" \
    "$(gum style --faint "arda help · all commands      arda setup · run this again")"
else
  ui_title "All set 🐈"; printf '%s\n\n' "$summary"; ui_info "arda help · all commands · arda setup · run this again"
fi
