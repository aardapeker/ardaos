#!/usr/bin/env bash
# desc: switch the color theme everywhere (live preview!)
#   arda theme              → menu with live preview
#   arda theme apply <id>   → apply directly
#   arda theme list | current
set -euo pipefail
source "${ARDAOS_LIB:-/usr/lib/ardaos}/lib.sh"

THEMES="$ARDAOS_SHARE/themes"
TEMPLATES="$ARDAOS_SHARE/templates"

theme_file() { local f="$THEMES/$1.theme"; [[ -f $f ]] || { ui_fail "no theme '$1'"; exit 1; }; echo "$f"; }
theme_ids()  { for f in "$THEMES"/*.theme; do basename "$f" .theme; done; }
theme_name() { sed -n 's/^name *= *//p' "$(theme_file "$1")"; }

# Turn a theme file (key=value) into a sed script: {{key}}, {{key_hex}}, {{key_rgb}}
sed_script() {
  local key val
  printf 's|{{ardaos_share}}|%s|g\n' "$ARDAOS_SHARE"
  while IFS='=' read -r key val; do
    key=${key//[[:space:]]/}; val=${val#"${val%%[![:space:]]*}"}; val=${val%"${val##*[![:space:]]}"}
    [[ -z $key || $key == \#* ]] && continue
    printf 's|{{%s}}|%s|g\n' "$key" "$val"
    if [[ $val =~ ^#([0-9a-fA-F]{2})([0-9a-fA-F]{2})([0-9a-fA-F]{2})$ ]]; then
      printf 's|{{%s_hex}}|%s|g\n' "$key" "${val#\#}"
      printf 's|{{%s_rgb}}|%d;%d;%d|g\n' "$key" \
        "0x${BASH_REMATCH[1]}" "0x${BASH_REMATCH[2]}" "0x${BASH_REMATCH[3]}"
    fi
  done < "$1"
}

# Which templates belong on this machine? (.termux/ only in Termux)
templates() {
  find "$TEMPLATES" -type f | while read -r t; do
    rel=${t#"$TEMPLATES"/}
    [[ $rel == .termux/* ]] && ! is_termux && continue
    echo "$rel"
  done
}

# render <theme-id> <dest-root> [only-this-template]
render() {
  local script rel; script=$(mktemp)
  sed_script "$(theme_file "$1")" > "$script"
  for rel in ${3:-$(templates)}; do
    mkdir -p "$2/$(dirname "$rel")"
    sed -f "$script" "$TEMPLATES/$rel" > "$2/$rel"
    if grep -q '{{' "$2/$rel"; then ui_warn "unfilled placeholder in $rel"; fi
  done
  rm -f "$script"
}

reload_apps() {
  pkill -USR1 -x kitty 2>/dev/null || true                     # kitty re-reads its config
  if in_sway; then swaymsg reload >/dev/null 2>&1 || true; fi   # wallpaper + borders
  if has termux-reload-settings; then termux-reload-settings; fi
}

live() {  # recolor the screen right now (used while scrolling the menu)
  if is_termux; then
    render "$1" "$HOME" .termux/colors.properties
    termux-reload-settings 2>/dev/null || true
  elif [[ -n ${KITTY_LISTEN_ON:-} ]] && has kitty; then
    local tmp; tmp=$(mktemp -d)
    render "$1" "$tmp" .config/kitty/theme.conf
    kitty @ set-colors --all "$tmp/.config/kitty/theme.conf" >/dev/null 2>&1 || true
    rm -rf "$tmp"
  fi
}

swatch() {  # pretty preview of a theme's palette
  local f k v; f=$(theme_file "$1")
  printf '\n  \e[1m%s\e[0m\n\n' "$(theme_name "$1")"
  for k in bg surface fg muted accent accent2 red green yellow blue magenta cyan; do
    v=$(sed -n "s/^$k *= *//p" "$f")
    [[ $v =~ ^#(..)(..)(..)$ ]] || continue
    printf '  \e[48;2;%d;%d;%dm      \e[0m  %-8s %s\n' \
      "0x${BASH_REMATCH[1]}" "0x${BASH_REMATCH[2]}" "0x${BASH_REMATCH[3]}" "$k" "$v"
  done
}

apply() {
  render "$1" "$HOME"
  state_set THEME "$1"
  reload_apps
  ui_ok "theme → $(theme_name "$1")"
}

case "${1:-menu}" in
  list)     theme_ids ;;
  current)  state_get THEME ;;
  name)     theme_name "${2:-$(state_get THEME)}" ;;
  apply)    apply "${2:?usage: $ARDAOS_CMD theme apply <id>}" ;;
  _swatch)  swatch "$2" ;;
  _live)    live "$2" ;;
  menu)
    has fzf || { ui_fail "fzf missing — use: $ARDAOS_CMD theme apply <id>"; theme_ids; exit 1; }
    current=$(state_get THEME); self="$ARDAOS_LIB/commands/theme"
    if pick=$(theme_ids | fzf --prompt "theme ❯ " --height 100% \
        --header "↑↓ preview live · Enter apply · Esc cancel" \
        --preview "$self _swatch {}" --preview-window right,60% \
        --bind "focus:execute-silent($self _live {})"); then
      apply "$pick"
    else
      if [[ -n $current ]]; then live "$current"; fi   # put the old colors back
      ui_info "nothing changed"
    fi ;;
  *) ui_fail "usage: $ARDAOS_CMD theme [list|current|name|apply <id>]"; exit 1 ;;
esac
