# What Fedora doesn't package → fetched from GitHub releases.
# kind | owner/repo | asset regex | binaries (bin) or font name (font)

bin  | starship/starship      | x86_64-unknown-linux-musl\.tar\.gz$             | starship
bin  | eza-community/eza      | eza_x86_64-unknown-linux-gnu\.tar\.gz$          | eza
bin  | zellij-org/zellij      | zellij-x86_64-unknown-linux-musl\.tar\.gz$      | zellij
bin  | sxyazi/yazi            | yazi-x86_64-unknown-linux-musl\.zip$           | yazi ya
bin  | jesseduffield/lazygit  | _linux_x86_64\.tar\.gz$                         | lazygit
bin  | charmbracelet/gum      | _linux_x86_64\.tar\.gz$                         | gum
bin  | atuinsh/atuin          | atuin-x86_64-unknown-linux-gnu\.tar\.gz$       | atuin
bin  | aome510/spotify-player | x86_64-unknown-linux-gnu\.tar\.gz$              | spotify_player

# Nerd Font versions (icons included) — .tar.xz is ~10x smaller than .zip
font | ryanoasis/nerd-fonts     | ^JetBrainsMono\.tar\.xz$                      | JetBrainsMono-NF
