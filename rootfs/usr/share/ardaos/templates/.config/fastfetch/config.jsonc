// generated by `arda theme` — {{name}}
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "{{ardaos_share}}/logo.txt",
    "color": { "1": "38;2;{{accent_rgb}}", "2": "38;2;{{accent2_rgb}}" },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;{{accent_rgb}}", "title": "38;2;{{accent2_rgb}}" }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "os", "key": "os    " },
    { "type": "kernel", "key": "kernel" },
    { "type": "uptime", "key": "uptime" },
    { "type": "shell", "key": "shell " },
    { "type": "memory", "key": "memory" },
    { "type": "command", "key": "theme ", "text": "arda theme name" },
    { "type": "command", "key": "font  ", "text": "arda font current" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
